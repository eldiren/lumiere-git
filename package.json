{
  "name": "lumiere-git",
  "productName": "Lumiere Git",
  "version": "0.0.1",
  "description": "Graphical repo management tools",
  "homepage": "https://www.lolumi.com/",
  "desktopName": "lumiere-git.desktop",
  "main": "./electron/dist/main.js",
  "type": "module",
  "author": {
    "name": "Logiciel Lumiere",
    "email": "support@lolumi.com",
    "url": "https://www.lolumi.com/"
  },
  "copyright": "Copyright (C) Logiciel Lumiere",
  "repository": {
    "type": "git",
    "url": "https://gitea.lolumi.com/eldiren/lumiere-git.git"
  },
  "private": true,
  "bugs": {
    "url": "https://gitea.lolumi.com/eldiren/lumiere-git/issues"
  },
  "license": "MIT",
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "start": "vite dev",
    "start:electron": "npm-run-all --parallel start dev:electron",
    "build": "vite build",
    "build:electron": "tsc --project electron/tsconfig.json",
    "dev:electron": "pnpm run build:electron && electron .",
    "make:electron": "pnpm run build && pnpm run build:electron && electron-builder build -p always -c electron-builder.config.ts",
    "make:flatpak": "pnpm run build && pnpm run build:electron && electron-builder build --linux flatpak -p never -c electron-builder.config.ts",
    "make:win": "pnpm run build && pnpm run build:electron && electron-builder build --win zip --x64 -p never -c electron-builder.config.ts -c.npmRebuild=false",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit --project electron/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "rebuild:native": "electron-builder install-app-deps",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "dprint check",
    "fmt:fix": "dprint fmt"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "chardet": "^1.5.1",
    "color": "^4.2.0",
    "default-shell": "^1.0.1",
    "fs-extra": "5.0.0",
    "fuzzaldrin-plus": "^0.6.0",
    "git-url-parse": "^11.1.0",
    "iconv-lite": "^0.6.3",
    "lodash": "^4.18.1",
    "moment": "^2.29.4",
    "node-pty": "1.1.0",
    "prismjs": "^1.30.0",
    "semver": "7.7.4"
  },
  "devDependencies": {
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.47.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.0",
    "@sveltejs/vite-plugin-svelte": "^5.1.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/color": "~3.0.6",
    "@types/fs-extra": "~5.0.5",
    "@types/fuzzaldrin-plus": "~0.6.5",
    "@types/git-url-parse": "~9.0.3",
    "@types/lodash": "~4.17.9",
    "@types/node": "^22.7.4",
    "@types/prismjs": "~1.26.4",
    "@types/semver": "~7.5.8",
    "bits-ui": "^2.19.0",
    "clsx": "^2.1.1",
    "dprint": "^0.54.0",
    "electron": "41.3.0",
    "electron-builder": "^26.15.3",
    "mode-watcher": "^1.1.0",
    "npm-run-all2": "^9.0.3",
    "oxlint": "^1.65.0",
    "paneforge": "^1.0.2",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.0",
    "svelte-sonner": "^1.2.0",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.0",
    "vite": "6.4.3",
    "vitest": "^4.1.0"
  }
}
